# ─── required in production ──────────────────────────────────────────────────

# Signs the session cookie. Without it nobody can sign in.
# Generate one with: openssl rand -base64 32
# Changing it signs everyone out, so pick a value and keep it.
# Local development falls back to a fixed dev key and needs no setup.
SESSION_SECRET=replace-with-a-long-random-secret

# Postgres connection string — on Vercel use Supabase's transaction pooler
# (port 6543). A deployed instance MUST have this: the SQLite fallback cannot be
# written on a serverless filesystem, and the app refuses to start without it.
# DATABASE_URL is read as a fallback if POSTGRES_URL is unset.
# Leave both empty locally and the app uses SQLite.
POSTGRES_URL=

# ─── recommended ─────────────────────────────────────────────────────────────

# Absolute base URL, used to build sign-in links and the Google callback.
# Falls back to the incoming request's origin, which is usually right on Vercel
# but wrong behind some proxies and on preview deployments.
APP_ORIGIN=http://localhost:3000

# ─── optional: sign-in with Google ───────────────────────────────────────────
# Create a Google OAuth "Web application" client and register
# <APP_ORIGIN>/api/auth/google/callback as an authorised redirect URI.
# The button only appears when both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── optional: sign-in links by email, via https://resend.com ────────────────
# Without a key the link is printed to the server console, which is enough for
# local work but useless in production.
# RESEND_FROM must be on a domain verified with Resend — the default sandbox
# sender only delivers to the address that owns the key.
RESEND_API_KEY=
RESEND_FROM=Minimarket <login@yourdomain.com>

# ─── optional: local only ────────────────────────────────────────────────────

# Moves the local SQLite file. Ignored when Postgres is configured.
# DATABASE_PATH=data/minimarket.db

# ── billing ──────────────────────────────────────────────────────────────────
# Unset, the app runs the stub in src/lib/billing.ts: plans change immediately,
# nothing is charged, and every screen says so. Set these and the Stripe adapter
# takes over. The season prices are one-off (mode: payment), not subscriptions.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_PLUS_MONTHLY=price_...
# STRIPE_PRICE_PLUS_ANNUAL=price_...
# STRIPE_PRICE_PLUS_SEASON=price_...
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_PRICE_PRO_ANNUAL=price_...
# STRIPE_PRICE_PRO_SEASON=price_...
