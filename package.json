{
  "name": "minimarket",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "seed": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/seed.ts",
    "test": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/test-amm.ts && node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/test-chart.ts && node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/test-engine.ts",
    "typecheck": "tsc --noEmit",
    "profile": "DEBUG_SQL=1 node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/profile.ts"
  },
  "dependencies": {
    "@vercel/speed-insights": "^2.0.0",
    "next": "15.5.22",
    "postgres": "^3.4.9",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2"
  }
}
