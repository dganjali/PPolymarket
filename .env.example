SESSION_SECRET=replace-with-a-long-random-secret
APP_ORIGIN=http://localhost:3000

# Required on Vercel: use Supabase's transaction-pooler connection string.
# Local development falls back to SQLite when this is unset.
POSTGRES_URL=

# Optional: create a Google OAuth "Web application" client and register
# http://localhost:3000/api/auth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: sign-in links by email, via https://resend.com. Without a key the
# link is printed to the server console instead, which is enough for local work.
# RESEND_FROM must be on a domain verified with Resend; the default sandbox
# sender only delivers to the address that owns the key.
RESEND_API_KEY=
RESEND_FROM=Minimarket <login@yourdomain.com>
